# Copy this file to .env for local development. Never put real secrets here.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Django -> FastAPI. Use http://ai-api:8081/chat for the Docker Compose service.
AI_API_URL=http://127.0.0.1:8081/chat

# Local Docker PostgreSQL. Use a strong, unique password.
POSTGRES_DB=gym_ai
POSTGRES_USER=gym_ai
POSTGRES_PASSWORD=replace-with-a-strong-alphanumeric-password

# The API's Groq and Hugging Face keys.
GROQ_API_KEY=replace-with-your-groq-api-key
HF_TOKEN=replace-with-your-huggingface-token
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LangSmith tracing. Keep request/response content hidden in recorded traces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=gym-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
